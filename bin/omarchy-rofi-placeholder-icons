#!/usr/bin/env python3
"""Erzeugt Platzhalter-Icons fuer .desktop-Eintraege ohne auffindbares Icon.

Betrifft vor allem Webapps und TUI-Starter. Das Ergebnis ist eine abgerundete
Kachel mit weichem Verlauf und Monogramm -- im Stil der uebrigen Icons, damit
das Raster nicht von grauen Fragezeichen durchbrochen wird.

Die Farbe leitet sich deterministisch aus dem Icon-Namen ab (SHA-256 -> Hue):
dieselbe App bekommt immer dieselbe Farbe, die Palette streut aber ueber den
ganzen Farbkreis.

  --dry-run   nur anzeigen, was erzeugt wuerde
  --force     auch vorhandene Platzhalter neu schreiben
"""
import argparse
import configparser
import glob
import hashlib
import os
import subprocess
import sys

ICON_DIR = os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps")
APP_DIRS = ["/usr/share/applications",
            os.path.expanduser("~/.local/share/applications")]
SEARCH = ["/usr/share/icons", "/usr/share/pixmaps",
          os.path.expanduser("~/.local/share/icons")]
# Marker in der Datei: nur selbst erzeugte Icons werden ueberschrieben.
MARKER = "<!-- omarchy-rofi-placeholder -->"


def icon_exists(name):
    """Sucht ein Icon in den ueblichen Themenpfaden."""
    if name.startswith("/"):
        return os.path.exists(name)
    for root in SEARCH:
        for ext in ("png", "svg", "xpm"):
            if glob.glob(f"{root}/**/{name}.{ext}", recursive=True):
                return True
    return False


def monogram(name):
    """Kurzform aus dem App-Namen: Initialen, sonst die ersten Buchstaben."""
    parts = [p for p in name.replace("-", " ").replace("_", " ").split() if p]
    skip = {"the", "and", "for", "of"}
    words = [p for p in parts if p.lower() not in skip] or parts
    if len(words) >= 2:
        return words[0][0].upper() + words[1][0].lower()
    return (words[0][0].upper() + words[0][1:2].lower()) if words else "?"


def disambiguate(name, mono, used):
    """Zweites Zeichen variieren, bis das Monogramm eindeutig ist."""
    words = [w for w in name.replace("-", " ").replace("_", " ").split() if w]
    last = words[-1] if words else name
    # Kandidaten: erst Konsonanten des letzten Wortes (Ma -> Ms fuer "Maps"
    # vs. "Messages"), dann dessen uebrige Buchstaben, dann der Rest des
    # ersten Wortes.
    tail = last[1:]
    pool = [c for c in tail if c.lower() not in "aeiou"] + list(tail) \
        + list(words[0][1:] if words else "")
    for ch in pool:
        if not ch.isalpha():
            continue
        cand = mono[0] + ch.lower()
        if cand not in used:
            return cand
    # Notnagel: durchnummerieren statt zwei gleiche Kacheln zu erzeugen.
    for n in range(2, 10):
        cand = mono[0] + str(n)
        if cand not in used:
            return cand
    return mono


def svg(mono, hue):
    # Einbuchstabige Monogramme duerfen groesser sein als zweibuchstabige.
    size = 62 if len(mono) == 1 else 50
    return f'''<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 128 128">
  {MARKER}
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="hsl({hue},42%,46%)"/>
      <stop offset="100%" stop-color="hsl({hue},46%,32%)"/>
    </linearGradient>
  </defs>
  <rect x="6" y="6" width="116" height="116" rx="27" fill="url(#g)"/>
  <rect x="6.5" y="6.5" width="115" height="115" rx="26.5" fill="none"
        stroke="rgba(255,255,255,0.16)" stroke-width="1"/>
  <text x="64" y="66" text-anchor="middle" dominant-baseline="central"
        font-family="Adwaita Sans" font-size="{size}"
        font-weight="900" letter-spacing="-0.5"
        fill="rgba(255,255,255,0.97)">{mono}</text>
</svg>
'''


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true")
    args = ap.parse_args()

    os.makedirs(ICON_DIR, exist_ok=True)
    todo, used = {}, {}

    for d in APP_DIRS:
        for f in sorted(glob.glob(d + "/*.desktop")):
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                cp.read(f, encoding="utf-8")
            except Exception:
                continue
            if "Desktop Entry" not in cp:
                continue
            e = cp["Desktop Entry"]
            if e.get("NoDisplay", "").lower() == "true":
                continue
            icon = e.get("Icon", "").strip()
            name = e.get("Name", "").strip()
            if not icon or not name:
                continue
            target = os.path.join(ICON_DIR, icon + ".svg")
            # Vorhandenes echtes Icon gewinnt -- ausser es ist unser Platzhalter.
            if icon_exists(icon):
                if not (os.path.exists(target)
                        and MARKER in open(target, encoding="utf-8").read()):
                    continue
                if not args.force:
                    continue
            if "/" in icon:
                continue
            mono = monogram(name)
            # Kollisionen aufloesen: zwei Apps duerfen nicht gleich aussehen.
            # "Google Maps" und "Google Messages" ergaeben beide "Gm", deshalb
            # wird der zweite Buchstabe aus dem *letzten* Wort nachgezogen
            # (Ma/Ms) statt aus dem gemeinsamen Praefix.
            if mono in used and used[mono] != icon:
                mono = disambiguate(name, mono, used)
            used[mono] = icon
            todo[icon] = mono

    if not todo:
        print("Keine Eintraege ohne Icon gefunden.")
        return 0

    for icon, mono in sorted(todo.items()):
        hue = int(hashlib.sha256(icon.encode()).hexdigest()[:8], 16) % 360
        print(f"  {mono:<3} {icon}")
        if not args.dry_run:
            with open(os.path.join(ICON_DIR, icon + ".svg"), "w",
                      encoding="utf-8") as fh:
                fh.write(svg(mono, hue))

    if args.dry_run:
        print(f"\n{len(todo)} Icons wuerden erzeugt (--dry-run).")
        return 0

    print(f"\n{len(todo)} Platzhalter in {ICON_DIR}")
    subprocess.run(["gtk-update-icon-cache", "-f", "-t",
                    os.path.expanduser("~/.local/share/icons/hicolor")],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
