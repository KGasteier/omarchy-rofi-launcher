#!/usr/bin/env bash
# Mac-artiger App-Launcher auf Basis von rofi.
#
# Toggle: laeuft rofi bereits, wird es beendet statt ein zweites Fenster zu
# oeffnen. pkill -x (exakter Prozessname) statt pkill rofi -- ein Teilstring
# traefe auch fremde Prozesse, die "rofi" im Namen oder in der Kommandozeile
# tragen.
set -u

# Themendatei: bevorzugt die vom Omarchy-Theme erzeugte Fassung, sonst die
# statische Kopie in ~/.config/rofi.
THEME_THEMED="$HOME/.local/state/omarchy/current/theme/applauncher.rasi"
THEME_STATIC="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/applauncher.rasi"

if [[ -f $THEME_THEMED ]]; then
  THEME="$THEME_THEMED"
else
  THEME="$THEME_STATIC"
fi

if pgrep -x -u "$USER" rofi >/dev/null 2>&1; then
  pkill -x -u "$USER" rofi
  exit 0
fi

# Eigener Modus statt des eingebauten drun: Er stellt eine Zeile mit den
# zuletzt benutzten Anwendungen voran und meldet sie rofi als "urgent",
# damit das Theme sie mit einer Trennlinie absetzen kann. Gibt es keine
# zuletzt benutzten Anwendungen, entfaellt die Zeile ersatzlos.
MODE_BIN="$(dirname "$(readlink -f "$0")")/omarchy-rofi-drun-recent"
[[ -x $MODE_BIN ]] || MODE_BIN="$HOME/.local/bin/omarchy-rofi-drun-recent"

# Spaltenzahl aus dem Theme lesen, damit Fuellzellen und Raster
# zusammenpassen -- sonst bricht die Trennlinie an der falschen Stelle um.
cols=$(sed -n 's/^[[:space:]]*columns:[[:space:]]*\([0-9]\+\).*/\1/p' "$THEME" | head -1)
export ROFI_LAUNCHER_COLUMNS="${cols:-7}"

# Den Prompt (die Lupe) setzt der Modus selbst per Kopfzeile -- bei
# Script-Modi wirkt -display-<name> nicht.
exec rofi -show apps -modi "apps:$MODE_BIN" -theme "$THEME"
